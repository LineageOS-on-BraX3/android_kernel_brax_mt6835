GKI_KERNEL_DIR=common
GKI_BUILD_CONFIG=${GKI_KERNEL_DIR}/build.config.gki.aarch64
GKI_SKIP_CP_KERNEL_HDR=1

. ${ROOT_DIR}/common/build.config.common
. ${ROOT_DIR}/common/build.config.aarch64

KERNEL_DIR=kernel-5.15

# SKIP_MRPROPER=1
DEFCONFIG=mgk_64_k515_gki_defconfig
FRAGMENTS_CONFIG="
${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/mgk_64_k515_defconfig
${ROOT_DIR}/${KERNEL_DIR}/kernel/configs/entry_level.config
"
PRE_DEFCONFIG_CMDS="KCONFIG_CONFIG=${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG} ${ROOT_DIR}/${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -r ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/gki_defconfig ${FRAGMENTS_CONFIG}"
POST_DEFCONFIG_CMDS="rm ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG}"
INSTALL_MOD_STRIP=1

EXTRA_CMDS="python ${ROOT_DIR}/system/libufdt/utils/src/mkdtboimg.py cfg_create ${ROOT_DIR}/out/${BRANCH}/${KERNEL_DIR}/arch/arm64/boot/dtbo.img ${ROOT_DIR}/kernel-brax/dtboimg.cfg -d ${ROOT_DIR}/out/${BRANCH}/${KERNEL_DIR}/arch/arm64/boot/dts/mediatek"
DIST_CMDS="python ${ROOT_DIR}/kernel-brax/append_certs.py --alignment 16 --cert1 ${ROOT_DIR}/kernel-brax/security/cert1.bin --cert2 ${ROOT_DIR}/kernel-brax/security/cert2.bin --dtbo ${ROOT_DIR}/out/${BRANCH}/dist/dtbo.img"

DTC='${OUT_DIR}/scripts/dtc/dtc'

MAKE_GOALS="
modules
mediatek/mt6835.dtb
mediatek/k6835v1_64.dtbo
"

FILES="
arch/arm64/boot/dtbo.img
arch/arm64/boot/dts/mediatek/mt6835.dtb
arch/arm64/boot/dts/mediatek/k6835v1_64.dtbo
.config
Module.symvers
"

ABI_DEFINITION=android/abi_gki_aarch64.xml
KMI_SYMBOL_LIST=android/abi_gki_aarch64
ADDITIONAL_KMI_SYMBOL_LISTS="
android/abi_gki_aarch64_virtual_device
android/abi_gki_aarch64_virtual_device_removed
android/abi_gki_aarch64_db845c
android/abi_gki_aarch64_fips140
android/abi_gki_aarch64_pixel
android/abi_gki_aarch64_mtktv
android/abi_gki_aarch64_mtk
android/abi_gki_aarch64_qcom
"
# KMI_ENFORCED=1

EXT_MODULES+="
vendor/mediatek/kernel_modules/connectivity/common
vendor/mediatek/kernel_modules/connectivity/connfem
vendor/mediatek/kernel_modules/connectivity/bt/mt66xx/wmt
vendor/mediatek/kernel_modules/connectivity/fmradio
vendor/mediatek/kernel_modules/connectivity/gps/gps_pwr
vendor/mediatek/kernel_modules/connectivity/gps/gps_stp
vendor/mediatek/kernel_modules/connectivity/wlan/adaptor
vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m
vendor/mediatek/kernel_modules/gpu
"

TARGET_BUILD_VARIANT=user

BT_PLATFORM=connac1x
LOG_TAG=[BT_Drv][wmt]

CONFIG_FM_USER_LOAD=1

CONFIG_MTK_COMBO_WIFI_HIF=axi
CONNAC_VER=1_0
MTK_ANDROID_EMI=y
MTK_ANDROID_WMT=y
MTK_COMBO_CHIP=SOC2_1X1
MTK_WLAN_SERVICE=yes
WIFI_IP_SET=1
WLAN_CHIP_ID=6835
